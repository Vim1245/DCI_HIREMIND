# ==============================================================================
# DCI HireMind - Enterprise AI Recruitment Platform Configuration Template
# NOTE: Do not commit real credentials or secrets to version control.
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="DCI HireMind API"
API_V1_STR=/api/v1
PORT=8000

SECRET_KEY=replace_with_a_secure_random_32_character_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_STORAGE_BUCKET_RESUMES=resumes

# Supabase PostgreSQL Configuration (Primary Database)
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=your_supabase_database_password

# Direct Database URL:
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Explicit Local Testing Override (Never silent fallback in production)
USE_SQLITE=false

# Local Ollama AI Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI API Configuration (Primary LLM Provider)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# LangSmith Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=dci-hiremind
